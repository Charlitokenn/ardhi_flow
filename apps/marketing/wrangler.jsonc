{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ardhi-flow-marketing",
  "compatibility_date": "2026-08-01",

  // Server-rendered via @astrojs/cloudflare: pages with `prerender = false`
  // (country-aware pricing, see src/middleware.ts) run in this Worker; every
  // other page is prerendered and served straight from the assets binding.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}
