---
import { AppConfig } from "../constants";
import {isTanzania} from "../constants/pricing.ts";
const logos = AppConfig.featuredClients;

const countryCode = Astro.locals.countryCode || "US";
const isLocal =  isTanzania(countryCode);
---

<section id="top" class="relative overflow-hidden">
  <div class="absolute inset-0 dotted-bg opacity-70"></div>

  <div class="relative mx-auto max-w-6xl px-4 pb-16 pt-36 -mt-8 text-center sm:pt-40">
    <div
        class="mx-auto mb-6 inline-flex items-center gap-2 rounded-pill border border-black/5 bg-white/70 px-4 py-1.5 text-sm font-medium text-muted backdrop-blur"
    >
      <span class="h-2 w-2 rounded-full bg-brand"></span>
      Built for growth-focused businesses
    </div>

    { isLocal ?
        <h1 class="mx-auto max-w-4xl text-balance font-display text-5xl font-extrabold leading-[1.02] tracking-tight text-ink sm:text-6xl md:text-7xl">
            Your stock. Your business<br /> always<br/>
                 <span class="text-gradient">accurate & current</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-pretty text-lg leading-relaxed text-muted">
          {AppConfig.appName} turns your handwritten stock counts into live, searchable data - so you know exactly what's on the shelf, what's running low, and what's making you money.
          No more flipping pages or guessing.
        </p>
        :
        <h1 class="mx-auto max-w-4xl text-balance font-display text-5xl font-extrabold leading-[1.02] tracking-tight text-ink sm:text-6xl md:text-7xl">
          Clear books. Confident stock <br/>
          <span class="text-gradient"> Calm mind</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-pretty text-lg leading-relaxed text-muted">
         {AppConfig.appName} keeps your accounting, invoicing, payments and stock levels in one unified system.
          Gain financial clarity, avoid stockouts, and stay tax-ready year-round.
        </p>
    }

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">

        <button
            type="button"
            data-open-modal="trial-modal"
            data-cta-location="hero"
            class="inline-flex cursor-pointer items-center rounded-pill bg-brand px-8 py-4 text-base font-semibold text-white shadow-soft transition-transform "
        >
          Start free trial
        </button>

        <a
            href="#demo"
            class="inline-flex items-center cursor-pointer rounded-pill border border-black/10 bg-white px-8 py-4 text-base font-semibold text-ink transition-colors hover:bg-black/5"
        >
          Interactive Demo
        </a>
    </div>

    <p class="mt-12 text-sm font-medium text-muted">Trusted by growing businesses</p>
    <div class="mt-5 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {
        logos.map((logo) => (
            <span class="font-display text-xl font-bold text-ink/30">{logo}</span>
        ))
      }
    </div>

    <div id="demo" class="relative mx-auto mt-16 max-w-full rounded-lg scroll-mt-28">
      <div style="position: relative; padding-bottom: calc(61.23893805309735% + 41px); height: 0; width: 100%;">
        <iframe
            src="https://demo.arcade.software/FeRaybGnq8w8icVFYOSu?embed&embed_mobile=tab&embed_desktop=inline&show_copy_link=true"
            title={`${AppConfig.appName} Interactive Demo`}
            frameborder="0"
            loading="lazy"
            allowfullscreen
            allow="clipboard-write"
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; color-scheme: light;"
        ></iframe>
      </div>
    </div>
  </div>
</section>