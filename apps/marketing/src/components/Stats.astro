---
const stats = [
  { value: "12 min", label: "Average time to close the books" },
  { value: "98%", label: "Transactions auto-categorized" },
  { value: "$0", label: "Surprise hourly invoices, ever" },
  { value: "10k+", label: "Founders keeping clean books" },
]
---

<section class="mx-auto max-w-6xl px-4 py-20">
  <div class="grid grid-cols-2 gap-8 rounded-3xl border border-black/5 bg-white p-10 shadow-card md:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="text-center">
          <p class="font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
            {stat.value}
          </p>
          <p class="mt-2 text-sm font-medium text-muted">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>
