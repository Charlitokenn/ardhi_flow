---
import { Copy, MessageCircle } from "@lucide/astro";
import { AppConfig } from "../constants";
import { getPrice, getCurrencySymbol, isTanzania, isOneTime } from "../constants/pricing.ts";

export interface Props {
    id: string;
    title?: string;
}

const { id, title = "Complete Your Purchase" } = Astro.props;

const countryCode = Astro.locals.countryCode || "US";
const isLocal = isTanzania(countryCode);

// Find the one-time / fixed-price plan (currently "RareBooks Desktop") rather
// than matching on name, so this keeps working if the plan is ever renamed.
const plan = AppConfig.pricingPlans.find((p) => isOneTime(p));

const symbol = getCurrencySymbol(countryCode);
const rawPrice = plan ? getPrice(plan, countryCode) : "";
// isOneTime plans have identical monthly/yearly USD prices, and the TZS
// price is already a single string, so index 0 is always the right value
// whether getPrice returned a string (TZ) or a [monthly, yearly] pair (USD).
const price = Array.isArray(rawPrice) ? rawPrice[0] : rawPrice;
const displayPrice = `${symbol}${price}`;
const currency = isLocal ? "TZS" : "USD";
const planName = plan?.name ?? "RareBooks Desktop";

const lipaNamba = "67249290";
const lipaName = "LIPA CHARLES KENEDY NKONOKI";

const paymentMethod = isLocal ? "lipa_namba" : "paypal";
const confirmationMessage = isLocal
    ? `Hi, I've completed payment for ${planName} (Lifetime License), amount ${displayPrice} via M-Pesa Lipa Namba. Sharing my payment confirmation now.`
    : `Hi, I've completed payment for ${planName} (Lifetime License), amount ${displayPrice} via PayPal. Sharing my payment confirmation now.`;
---

<dialog
        id={id}
        class="modal-dialog m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl bg-background p-0 shadow-card backdrop:bg-ink/50 backdrop:backdrop-blur-md"
>
    <div class="relative">
        <!-- Close -->
        <button
                type="button"
                class="modal-close cursor-pointer absolute right-3 top-3 z-10 inline-flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-brand-soft hover:text-brand"
                aria-label="Close dialog"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>

        <div class="modal-content p-6 md:p-8">
            <h3 class="font-display text-xl font-bold text-ink">{title}</h3>
            <p class="mt-1 text-sm text-muted">{planName} · Lifetime license</p>

            <div class="mt-4 flex items-end gap-1">
                <span class="font-display text-4xl font-extrabold tracking-tight text-ink">{displayPrice}</span>
                <span class="mb-1 text-muted">one-time</span>
            </div>

            <!-- Step 1: Payment instructions - Lipa Namba for Tanzania,
                 PayPal hosted button for everyone else. -->
            {isLocal ? (
                <div class="mt-6 rounded-2xl bg-brand-soft/40 p-5">
                    <p class="text-xs font-semibold uppercase tracking-wide text-brand">Step 1 — Pay via M-Pesa</p>

                    <dl class="mt-3 space-y-3">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <dt class="text-xs text-muted">Lipa Namba</dt>
                                <dd class="font-display text-lg font-bold text-ink" data-lipa-number>{lipaNamba}</dd>
                            </div>
                            <button
                                    type="button"
                                    class="copy-btn inline-flex cursor-pointer items-center gap-1.5 rounded-pill border border-black/10 bg-white px-3 py-1.5 text-xs font-semibold text-ink transition-colors hover:bg-brand-soft"
                                    data-copy={lipaNamba}
                                    aria-label="Copy Lipa Namba number"
                            >
                                <Copy size={14} class="copy-icon" />
                                <span class="copy-label">Copy</span>
                            </button>
                        </div>
                        <div>
                            <dt class="text-xs text-muted">Name</dt>
                            <dd class="text-sm font-semibold text-ink">{lipaName}</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-muted">Amount</dt>
                            <dd class="text-sm font-semibold text-ink">{displayPrice}</dd>
                        </div>
                    </dl>
                </div>
            ) : (
                <div class="mt-6 rounded-2xl bg-brand-soft/40 p-5">
                    <p class="text-xs font-semibold uppercase tracking-wide text-brand">Step 1 — Pay via PayPal</p>
                    <p class="mt-2 text-sm leading-relaxed text-muted">
                        You'll be taken to PayPal in a new tab to complete your purchase
                        securely with your card or PayPal balance.
                    </p>

                    <form
                            action={`https://www.paypal.com/ncp/payment/${AppConfig.paypal.hostedButtonId}`}
                            method="post"
                            target="_blank"
                            class="mt-4 flex flex-col items-center gap-2"
                    >
                        <input
                                type="submit"
                                value="Buy Lifetime License"
                                data-gtm-payment-interest
                                data-plan-name={planName}
                                data-plan-price={displayPrice}
                                data-currency={currency}
                                data-cta-location="desktop_payment_modal"
                                class="inline-flex w-full cursor-pointer items-center justify-center rounded-pill bg-brand px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
                        />
                        <img src="https://www.paypalobjects.com/images/Debit_Credit.svg" alt="Visa, Mastercard, and other cards accepted" class="h-6" />
                        <span class="text-xs text-muted">
                            Powered by
                            <img src="https://www.paypalobjects.com/paypal-ui/logos/svg/paypal-wordmark-color.svg" alt="PayPal" class="inline h-3.5 align-middle" />
                        </span>
                    </form>
                </div>
            )}

            <!-- Step 2: Send confirmation via chat -->
            <div class="mt-6">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand">Step 2 — Send us confirmation</p>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                    {isLocal
                        ? "Once you've paid, tap below to open chat and send us your payment confirmation (M-Pesa message or screenshot). We'll verify it and reply with your download link and lifetime license key."
                        : "Once you've completed checkout on PayPal, tap below to open chat and send us your payment confirmation (PayPal receipt or transaction ID). We'll verify it and reply with your download link and lifetime license key."}
                </p>

                <button
                        type="button"
                        id="payment-confirm-btn"
                        data-gtm-payment-confirm
                        data-plan-name={planName}
                        data-plan-price={displayPrice}
                        data-currency={currency}
                        data-payment-method={paymentMethod}
                        data-cta-location="desktop_payment_modal"
                        data-confirmation-message={confirmationMessage}
                        class="mt-4 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-pill bg-brand px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
                >
                    <MessageCircle size={16} />
                    I've paid — send confirmation via chat
                </button>
                <p id="payment-confirm-note" class="mt-2 hidden text-xs text-brand">
                    Message copied — paste it into the chat along with your screenshot.
                </p>
            </div>
        </div>
    </div>
</dialog>

<style>
    body:has(dialog[open]) {
        overflow: hidden;
    }

    .modal-dialog {
        opacity: 0;
        transform: scale(0.96);
        transition: opacity 0.2s ease, transform 0.2s ease, overlay 0.2s ease allow-discrete;
    }

    .modal-dialog[open] {
        opacity: 1;
        transform: scale(1);
    }

    @starting-style {
        .modal-dialog[open] {
            opacity: 0;
            transform: scale(0.96);
        }
    }

    .modal-dialog::backdrop {
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .modal-dialog[open]::backdrop {
        opacity: 1;
    }

    @starting-style {
        .modal-dialog[open]::backdrop {
            opacity: 0;
        }
    }
</style>

<script>
    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const dialog = target.closest('dialog.modal-dialog');
        if (dialog && target === dialog) {
            (dialog as HTMLDialogElement).close();
        }
    });

    document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.modal-close');
        if (!btn) return;
        const dialog = btn.closest('dialog');
        if (dialog) (dialog as HTMLDialogElement).close();
    });

    // Copy the Lipa Namba number to the clipboard with brief visual feedback.
    // (Sending the confirmation-message copy + chat handoff + GTM push for
    // the "I've paid" button is handled centrally in Layout.astro, same
    // pattern as the [data-gtm-download] handler.)
    document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.copy-btn');
        if (!btn) return;
        const value = btn.getAttribute('data-copy');
        if (!value || !navigator.clipboard) return;

        navigator.clipboard.writeText(value).then(() => {
            const label = btn.querySelector('.copy-label');
            if (label) {
                const original = label.textContent;
                label.textContent = 'Copied!';
                setTimeout(() => {
                    label.textContent = original;
                }, 2000);
            }
        }).catch(() => {});
    });
</script>
