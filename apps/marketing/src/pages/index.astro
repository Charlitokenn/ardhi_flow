---
import '../styles/global.css';
import PlanIllustration from '../components/PlanIllustration.astro';
import Mark from '../components/Mark.astro';
import Navbar from "@components/Navbar.astro"
import Hero from "@components/Hero.astro"
import Comparison from "@components/Comparison.astro"
import HowItWorks from "@components/HowItWorks.astro"
import Stats from "@components/Stats.astro"
import Guarantee from "@components/Guarantee.astro"
import Pricing from "@components/Pricing.astro"
import CallToAction from "@components/CallToAction.astro"
import Footer from "@components/Footer.astro"
import Layout from "../layouts/Layout.astro"
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';

export const prerender = false;
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Comparison />
    <HowItWorks />
    <Stats />
    <Guarantee />
    <!--<Pricing />-->
    <CallToAction />
  </main>
  <Footer />
</Layout>

