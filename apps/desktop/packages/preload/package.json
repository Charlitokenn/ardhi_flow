{
  "name": "@ardhiflow/desktop-preload",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/_virtual_browser.mjs"
    },
    "./exposed.mjs": {
      "types": "./src/exposed.d.ts",
      "default": "./dist/exposed.mjs"
    }
  },
  "devDependencies": {
    "@ardhiflow/electron-versions": "workspace:*",
    "@types/node": "25.5.0",
    "electron": "41.0.3",
    "mlly": "1.8.2",
    "typescript": "6.0.2",
    "vite": "8.0.3"
  }
}
