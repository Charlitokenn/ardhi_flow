---
import { Icon } from '@astrojs/starlight/components';

const { dir, pagination } = Astro.locals.starlightRoute;
const isRtl = dir === 'rtl';

const prev = pagination && pagination.prev ? pagination.prev : null;
const next = pagination && pagination.next ? pagination.next : null;

const previousLabel = Astro.locals.t('page.previousLink');
const nextLabel = Astro.locals.t('page.nextLink');
---

<div class="pagination-container">
    {
        prev && (
                    <a href={prev.href} rel="prev" class="pagination-link prev">
        <span class="pagination-direction">
          <Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="1.25rem" class="pagination-icon" />
          <span class="pagination-label">{previousLabel}</span>
        </span>
                        <span class="pagination-title">{prev.label}</span>
                    </a>
        )
    }

    {
        next && (
                    <a href={next.href} rel="next" class="pagination-link next">
        <span class="pagination-direction">
          <span class="pagination-label">{nextLabel}</span>
          <Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="1.25rem" class="pagination-icon" />
        </span>
                        <span class="pagination-title">{next.label}</span>
                    </a>
        )
    }
</div>

<style>
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        gap: 1rem;
        padding: 1.5rem 0;
        border-top: 1px solid var(--sl-color-gray-5);
    }
    .pagination-link {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        text-decoration: none;
        color: var(--sl-color-white);
        padding: 0.75rem 0;
        transition: opacity 0.2s ease;
        /* Removed: flex: 1 and max-width: 50% */
    }
    .pagination-link:hover { opacity: 0.8; }
    .pagination-link.prev { align-items: flex-start; }
    .pagination-link.next {
        align-items: flex-end;
        text-align: right;
        margin-left: auto; /* Push to the right when alone */
    }
    .pagination-direction {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }
    .pagination-icon { flex-shrink: 0; }
    .pagination-label { font-weight: 500; }
    .pagination-title {
        font-size: var(--sl-text-lg);
        font-weight: 600;
        color: var(--sl-color-white);
        line-height: 1.3;
    }
    [dir='rtl'] .pagination-link.prev { align-items: flex-end; text-align: right; }
    [dir='rtl'] .pagination-link.next {
        align-items: flex-start;
        text-align: left;
        margin-left: 0;
        margin-right: auto; /* Push to the left in RTL */
    }
    @media (max-width: 640px) {
        .pagination-container { flex-direction: column; gap: 0.5rem; }
        .pagination-link.next {
            margin-left: 0;
            align-items: flex-start;
            text-align: left;
        }
        [dir='rtl'] .pagination-link.next {
            margin-right: 0;
            align-items: flex-end;
            text-align: right;
        }
    }
</style>