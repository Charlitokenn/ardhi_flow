---
import { BookOpen } from "@lucide/astro"
import { AppConfig } from "../constants"
// import AppLogo from "../components/AppLogo"

const columns = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Pricing", href: "/#pricing" },
      { label: "Demo", href: "/#demo" },
    ],
  },
  {
    title: "Compare",
    links: [
      { label: "All Comparisons", href: "/compare" },
      { label: "Alternatives Guides", href: "/alternatives" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Documentation", href: "/getting-started/getting-started-with-rarebooks/" },
    ],
  },
]
const year = new Date().getFullYear()
---

<footer class="border-t border-black/5 bg-background">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <!--<AppLogo link="/#top" client:load/>-->
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          {AppConfig.description}
        </p>
      </div>
      {
        columns.map((col) => (
            <div>
              <h4 class="mb-4 text-sm font-semibold text-ink">{col.title}</h4>
              <ul class="flex flex-col gap-3">
                {col.links.map((link) => (
                    <li>
                      <a
                          href={link.href}
                          class="text-sm text-muted transition-colors hover:text-ink"
                          {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                      >
                        {link.label}
                      </a>
                    </li>
                ))}
              </ul>
            </div>
        ))
      }
    </div>
    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-black/5 pt-6 sm:flex-row">
      <p class="text-sm text-muted">© {year} {AppConfig.appName}. All rights reserved.</p>
      <div class="flex gap-6">
        <!--<a href="/privacy/" class="text-sm text-muted transition-colors hover:text-ink">Privacy</a>-->
        <!--<a href="/terms/" class="text-sm text-muted transition-colors hover:text-ink">Terms</a>-->
        <!--<a href="/security/" class="text-sm text-muted transition-colors hover:text-ink">Security</a>-->
      </div>
    </div>
  </div>
</footer>
