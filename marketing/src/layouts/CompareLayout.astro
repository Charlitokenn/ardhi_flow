---
import Layout from "./Layout.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import TrialLicenseModal from "@components/TrialLicenseModal.astro";
import ContactUsModal from "@components/ContactUsModal.astro";
import { AppConfig } from "../constants";
import type { CompetitorEntry } from "../data/competitors";

interface Props {
  entry: CompetitorEntry;
}

const { entry } = Astro.props;
const pageTitle = `${AppConfig.appName} vs ${entry.shortName} | Platform Comparison`;
---

<Layout
  title={pageTitle}
  description={entry.metaDescription}
  canonicalPath={`/compare/${entry.slug}`}
>
  <Navbar />
  <main>
    <!-- Breadcrumb + Header -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 dotted-bg opacity-70"></div>
      <div class="relative mx-auto max-w-4xl px-4 pb-14 pt-36 text-center sm:pt-40">
        <nav class="mb-6 flex items-center justify-center gap-1.5 text-sm text-muted" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-ink">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/compare" class="transition-colors hover:text-ink">Compare</a>
          <span aria-hidden="true">/</span>
          <span class="text-ink">{AppConfig.appName} vs {entry.shortName}</span>
        </nav>

        <div class="mx-auto mb-6 inline-flex items-center gap-2 rounded-pill border border-black/5 bg-white/70 px-4 py-1.5 text-sm font-medium text-muted backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-brand"></span>
          Platform Comparison
        </div>

        <h1 class="text-balance font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl">
          {AppConfig.appName} vs {entry.name}
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-pretty text-lg leading-relaxed text-muted">
          Compare offline accounting software side-by-side. Feature depth, pricing models, and which one actually fits how your business runs.
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <button
            type="button"
            data-open-modal="trial-modal"
            data-cta-location="compare_page_header"
            class="inline-flex cursor-pointer items-center rounded-pill bg-brand px-8 py-4 text-base font-semibold text-white shadow-soft transition-transform"
          >
            Start free trial
          </button>
          <a
            href="/#pricing"
            class="inline-flex cursor-pointer items-center rounded-pill border border-black/10 bg-white px-8 py-4 text-base font-semibold text-ink transition-colors hover:bg-black/5"
          >
            See pricing
          </a>
        </div>
      </div>
    </section>

    <!-- Pricing Comparison -->
    <section class="mx-auto max-w-5xl px-4 py-8">
      <h2 class="mb-8 text-center font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Pricing Comparison
      </h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border-2 border-brand/20 bg-brand-soft/40 p-8 shadow-card">
          <h3 class="mb-3 font-display text-xl font-bold text-ink">{AppConfig.appName} Pricing</h3>
          <p class="text-base leading-relaxed text-ink/80">{entry.pricingRareBooks}</p>
        </div>
        <div class="rounded-3xl border border-black/5 bg-white p-8">
          <h3 class="mb-3 font-display text-xl font-bold text-muted">{entry.shortName} Pricing</h3>
          <p class="text-base leading-relaxed text-muted">{entry.pricingCompetitor}</p>
        </div>
      </div>
    </section>

    <!-- Best Fit Evaluation -->
    <section class="mx-auto max-w-5xl px-4 py-8">
      <h2 class="mb-8 text-center font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Best Fit Evaluation
      </h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-black/5 bg-white p-8">
          <h3 class="mb-3 font-display text-xl font-bold text-muted">Best for {entry.shortName}</h3>
          <p class="text-base leading-relaxed text-muted">{entry.bestForCompetitor}</p>
        </div>
        <div class="rounded-3xl border-2 border-brand/20 bg-brand-soft/40 p-8 shadow-card">
          <h3 class="mb-3 font-display text-xl font-bold text-ink">Best for {AppConfig.appName}</h3>
          <p class="text-base leading-relaxed text-ink/80">{entry.bestForRareBooks}</p>
        </div>
      </div>
    </section>

    <!-- Feature Matrix -->
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="mb-8 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Feature Matrix
      </h2>
      <div class="overflow-hidden rounded-3xl border border-black/5 bg-white shadow-card">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-black/5 bg-brand-soft/40">
                <th class="px-5 py-4 font-display font-bold text-ink">Capability</th>
                <th class="px-5 py-4 font-display font-bold text-brand">{AppConfig.appName}</th>
                <th class="px-5 py-4 font-display font-bold text-muted">{entry.shortName}</th>
              </tr>
            </thead>
            <tbody>
              {entry.featureMatrix.map((row, i) => (
                <tr class={i % 2 === 1 ? "bg-background/60" : ""}>
                  <td class="border-t border-black/5 px-5 py-4 font-medium text-ink">{row.capability}</td>
                  <td class="border-t border-black/5 px-5 py-4 text-ink/80">{row.rarebooks}</td>
                  <td class="border-t border-black/5 px-5 py-4 text-muted">{row.competitor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Deep Dives -->
    {entry.deepDives.map((dive) => (
      <section class="mx-auto max-w-5xl px-4 py-8">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">{dive.title}</h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{dive.intro}</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          <div class="rounded-3xl border-2 border-brand/20 bg-brand-soft/40 p-8 shadow-card">
            <h3 class="mb-3 font-display text-lg font-bold text-ink">{dive.rarebooks.heading}</h3>
            <p class="text-base leading-relaxed text-ink/80">{dive.rarebooks.body}</p>
          </div>
          <div class="rounded-3xl border border-black/5 bg-white p-8">
            <h3 class="mb-3 font-display text-lg font-bold text-muted">{dive.competitor.heading}</h3>
            <p class="text-base leading-relaxed text-muted">{dive.competitor.body}</p>
          </div>
        </div>
      </section>
    ))}

    <!-- Final Recommendation -->
    <section class="mx-auto max-w-4xl px-4 py-12">
      <h2 class="mb-6 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Final Recommendation
      </h2>
      <p class="text-base leading-relaxed text-muted">{entry.recommendationCompetitor}</p>
      <p class="mt-5 text-base leading-relaxed text-ink/80">{entry.recommendationRareBooks}</p>
    </section>

    <!-- Alternatives guide callout -->
    <section class="mx-auto max-w-4xl px-4 pb-8">
      <div class="flex flex-col items-start gap-4 rounded-3xl border border-black/5 bg-white p-8 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="font-display text-lg font-bold text-ink">Want to see the alternatives guide?</h3>
          <p class="mt-1 text-sm text-muted">Read our deep-dive on switching from {entry.shortName}.</p>
        </div>
        <a
          href={`/alternatives/${entry.slug}`}
          class="inline-flex shrink-0 items-center rounded-pill border border-black/10 bg-white px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-black/5"
        >
          View Alternatives Guide
        </a>
      </div>
    </section>

    <!-- Final CTA -->
    <section id="cta" class="mx-auto max-w-6xl px-4 pb-24 pt-8">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-ink px-6 py-20 text-center text-white">
        <div class="absolute inset-0 hero-glow opacity-60"></div>
        <div class="absolute inset-0 dotted-bg opacity-[0.05]"></div>
        <div class="relative mx-auto max-w-2xl">
          <h2 class="text-balance font-display text-4xl font-bold tracking-tight sm:text-5xl">
            Ready to switch to {AppConfig.appName}?
          </h2>
          <p class="mx-auto mt-5 max-w-lg text-pretty text-lg text-white/70">
            Start a free trial and see how {AppConfig.appName} handles your books, stock, and POS — no commitment required.
          </p>
          <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <button
              type="button"
              data-open-modal="trial-modal"
              data-cta-location="compare_page_footer"
              class="inline-flex cursor-pointer items-center rounded-pill bg-brand px-8 py-4 text-base font-semibold text-white shadow-soft transition-transform"
            >
              Start free trial
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<TrialLicenseModal id="trial-modal" title="Start your free trial" />
<ContactUsModal id="contact-us-modal" title="Contact Us" />
